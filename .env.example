# Copy this file to .env and fill in your Supabase project's values.
# Find both in the Supabase dashboard: Project Settings > API Keys.
# Use the "Publishable key" (starts with sb_publishable_...) — not the
# secret key, which must never be used in client-side code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx